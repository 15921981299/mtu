---
import type { PartBuyerEvidence } from '../data/part-buyer-evidence';
import { buyerEvidenceReviewed } from '../data/part-buyer-evidence';

interface Props { number: string; evidence: PartBuyerEvidence; }
const { number, evidence } = Astro.props;
---
<section class="buyer-evidence" data-buyer-evidence={number}>
  <h2>{number} Documented Identification</h2>
  <dl>
    {evidence.facts.map((fact) => <div>
      <dt>{fact.label}</dt>
      <dd>{fact.value} <a href={`#part-source-${fact.source}`} class="evidence-link" aria-label={`Source for ${fact.label}`}>Reference</a></dd>
    </div>)}
  </dl>
  <details>
    <summary>Reference documents and photographs</summary>
    <ul>{evidence.sources.map((source) => <li id={`part-source-${source.id}`}><a href={source.url}>{source.title}</a></li>)}</ul>
    <p class="reference-date">References reviewed {buyerEvidenceReviewed}. Current stock and offered-unit specifications are confirmed separately.</p>
  </details>
</section>
<style>
  .buyer-evidence { margin: 28px 0; padding: 22px 0; border-top: 1px solid #dbe3e8; }
  dl { margin: 18px 0; }
  dl > div { display: grid; grid-template-columns: minmax(150px, 1fr) minmax(0, 3fr); gap: 18px; padding: 14px 0; border-bottom: 1px solid #e2e8f0; }
  dt { font-weight: 600; }
  dd { margin: 0; line-height: 1.65; overflow-wrap: anywhere; }
  .evidence-link { font-size: 13px; white-space: nowrap; }
  a { color: #126bdf; text-decoration: underline; text-underline-offset: 3px; }
  summary { cursor: pointer; font-weight: 600; }
  .reference-date { color: #566575; font-size: 13px; }
  li { overflow-wrap: anywhere; }
  @media (max-width: 600px) { dl > div { grid-template-columns: minmax(0, 1fr); gap: 5px; } }
</style>
