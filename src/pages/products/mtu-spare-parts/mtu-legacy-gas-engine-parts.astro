---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbHero from '../../../components/BreadcrumbHero.astro';
import FunnelPageView from '../../../components/FunnelPageView.astro';
import DetailRfqStrip from '../../../components/DetailRfqStrip.astro';
import { mtuParts } from '../../../data/mtu-parts';
import { parseModels } from '../../../data/engine-models';
import { breadcrumbSchema, faqSchema, site } from '../../../data/site';
import '../../../styles/resource-page.css';

/**
 * Legacy series and gas-engine coverage.
 *
 * The indexed catalog data covers Series 183 through 1163 plus the current
 * 2000/4000 platforms. Older numeric series (331, 493, 652, 8000) and the
 * gas-rated L models are real MTU products with real fleets, but they are
 * not in the index — this page routes those enquiries instead of publishing
 * empty pages per series.
 */

type Coverage = {
  family: string;
  era: string;
  indexStatus: string;
  note: string;
};

const families: Coverage[] = [
  {
    family: 'Series 183',
    era: 'Legacy, in production for decades',
    indexStatus: 'Indexed',
    note: '8V/12V 183 and 6R 183 references are in the catalog data — see the parts lists by engine model.',
  },
  {
    family: 'Series 331',
    era: 'Legacy',
    indexStatus: 'By inquiry',
    note: 'Older in-line and V configurations. Send the model code and serial number; references are confirmed line by line.',
  },
  {
    family: 'Series 396',
    era: 'Legacy',
    indexStatus: 'Indexed',
    note: 'Group-3 codes are constant-speed generator duty; other groups are marine. The parts lists are published by engine model.',
  },
  {
    family: 'Series 493',
    era: 'Legacy',
    indexStatus: 'By inquiry',
    note: 'Smaller legacy series. Model code and serial number required before any reference is confirmed.',
  },
  {
    family: 'Series 538',
    era: 'Legacy',
    indexStatus: 'Indexed',
    note: '12V/16V/20V 538 references are in the catalog data.',
  },
  {
    family: 'Series 595',
    era: 'Legacy',
    indexStatus: 'Indexed',
    note: '12V/16V 595 TC/TE references are in the catalog data.',
  },
  {
    family: 'Series 652',
    era: 'Legacy',
    indexStatus: 'By inquiry',
    note: 'Older in-line series still found in marine and industrial service. Quoted line by line.',
  },
  {
    family: 'Series 8000',
    era: 'Large legacy platform',
    indexStatus: 'By inquiry',
    note: 'Very large displacement engines with a small installed base. Enquiries are checked individually.',
  },
  {
    family: 'Series 956 / 1163',
    era: 'Legacy',
    indexStatus: 'Indexed',
    note: 'TB/TE/TC references are in the catalog data, including generator group-3 codes.',
  },
  {
    family: 'Gas engines (L-rated)',
    era: 'Current',
    indexStatus: 'By inquiry',
    note: 'MTU gas genset engines (L codes) run on natural gas or biogas with different ignition, fuel-metering, and spark-related components from diesel engines. Quoted line by line against the model code.',
  },
  {
    family: 'Series 2000 / 4000 (G-rated diesel genset)',
    era: 'Current',
    indexStatus: 'Indexed',
    note: 'Diesel genset references for the G models are in the catalog data — see genset parts by power rating.',
  },
];

/** Series actually present in the indexed catalog data, for an honest count. */
const coveredSeries = new Set<string>();
for (const part of mtuParts) {
  for (const model of parseModels(part.applicableEngines)) {
    coveredSeries.add(model.series);
  }
}

const pageUrl = `${site.url}/products/mtu-spare-parts/mtu-legacy-gas-engine-parts/`;
const faqItems = [
  {
    question: 'My engine is a legacy MTU series not listed in your catalog. Can you still quote?',
    answer:
      'Yes. The index on this site covers the series with the largest reference base (183, 396, 538, 595, 956, 1163, 2000, 4000). For 331, 493, 652, 8000 and other legacy builds we work line by line from the model code and serial number — absence from the index never establishes unavailability.',
  },
  {
    question: 'Are gas-engine parts different from diesel parts?',
    answer:
      'Yes, substantially. A gas engine replaces the diesel injection equipment with gas admission, ignition, and spark-related components, and its pistons, rings, and connecting rods are designed for the different combustion load. Only the “universal” maintenance items — filters, belts, hoses, gaskets, sensors — overlap with the diesel engine of the same block family.',
  },
  {
    question: 'How do I read an old MTU model code?',
    answer:
      'In the legacy series (183, 331, 396, 538, 595, 652, 956, 1163), the code reads as cylinders + V/R + series + charging letters + two digits + build. The first digit after the charging letters is the application group: group 3 is constant-speed generator service, while groups 5, 6, 7 and 9 are marine applications. Send the full code and we will read it with you.',
  },
  {
    question: 'What information makes a legacy enquiry fastest to quote?',
    answer:
      'The complete model code, the engine serial number, and photos of the nameplate and the parts in question. For overhaul programs, include running hours and any known history (overheating events, previous rebuilds) — these decide which references are worth quoting and which are likely to be superseded.',
  },
];
---

<BaseLayout
  title="MTU Legacy Series & Gas Engine Parts — Sourcing by Model"
  description="MTU legacy series (183–8000) and gas engine (L-rated) coverage: what is indexed on this site and what is quoted line by line from the model code and serial number."
  currentPath="/products/mtu-spare-parts/mtu-legacy-gas-engine-parts"
  jsonLd={[
    breadcrumbSchema([
      { name: 'Home', url: site.url },
      { name: 'Products', url: `${site.url}/products/` },
      { name: 'MTU Spare Parts', url: `${site.url}/products/mtu-spare-parts/` },
      { name: 'Legacy Series & Gas Engines', url: pageUrl },
    ]),
    faqSchema(faqItems),
  ]}
>
  <FunnelPageView stage="selection" label="mtu-legacy-gas-engine-parts" />
  <BreadcrumbHero
    title="MTU Legacy Series & Gas Engines"
    trail={[
      { label: 'Home', href: '/' },
      { label: 'Products', href: '/products/' },
      { label: 'MTU Spare Parts', href: '/products/mtu-spare-parts/' },
      { label: 'Legacy Series & Gas Engines' },
    ]}
    variant="2"
  />

  <div class="resource-page">
    <section class="resource-page-section">
      <p>
        MTU has built engines under more model families than any single parts list covers. This site’s
        indexed catalog data spans <strong>{coveredSeries.size} series</strong> — 183, 396, 538, 595,
        956, 1163, 2000 and 4000 — where the reference base is largest. Older series and gas-rated
        engines are quoted <strong>line by line from the model code and serial number</strong> rather
        than published as empty pages.
      </p>
      <p class="resource-note">
        “Indexed” means part pages and engine-model lists are published on this site. “By inquiry” means
        the model is a real MTU product we source and quote individually — it does not mean unavailable.
      </p>
    </section>

    <section class="resource-page-section">
      <h2>Coverage by engine family</h2>
      <div class="xref-table-wrap">
        <table class="xref-table">
          <thead>
            <tr>
              <th scope="col">Engine Family</th>
              <th scope="col">Era</th>
              <th scope="col">Index Status</th>
              <th scope="col">What This Means for Your Enquiry</th>
            </tr>
          </thead>
          <tbody>
            {families.map((f) => (
              <tr>
                <td class="pn-engine">{f.family}</td>
                <td>{f.era}</td>
                <td>{f.indexStatus}</td>
                <td>{f.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>How legacy and gas enquiries are quoted</h2>
      <div class="catalog-depth-section">
        <div class="catalog-depth-card">
          <h3>01 — Read the code</h3>
          <p>
            Send the complete model code and serial number. For legacy series we read the charging
            letters, application group (group 3 = generator duty, groups 5/6/7/9 = marine), and build
            digit together with you, so the reference set matches the actual machine.
          </p>
        </div>
        <div class="catalog-depth-card">
          <h3>02 — Confirm each line</h3>
          <p>
            Every part number is checked against supplier data for that specific build — availability,
            grade, and supersession. For gas engines we additionally confirm the fuel and ignition
            variant, because those components do not interchange with the diesel engine of the same
            block family.
          </p>
        </div>
        <div class="catalog-depth-card">
          <h3>03 — Quote with gaps shown</h3>
          <p>
            You receive line-by-line availability and shipping options, with any line that cannot be
            confirmed clearly marked. A short honest list beats a long guess.
          </p>
        </div>
      </div>
    </section>

    <section class="resource-page-section">
      <h2>Related coverage</h2>
      <ul class="catalog-scenarios-list">
        <li>Series 1600 &amp; newer F-build models: <a href="/products/mtu-spare-parts/mtu-1600-series-parts/">MTU Series 1600 parts</a></li>
        <li>Genset parts by power rating: <a href="/products/mtu-spare-parts/mtu-genset-parts-by-power/">MTU genset parts by power rating</a></li>
        <li>Parts lists by engine model: <a href="/engine-models/">Parts lists by engine model</a></li>
        <li>Full part number index (EN · DE): <a href="/part-number-index/">MTU part number index</a></li>
      </ul>
    </section>

    <section class="resource-page-section">
      <h2>Legacy &amp; Gas FAQ</h2>
      {faqItems.map((item) => (
        <details class="resource-faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <DetailRfqStrip
      context="Legacy / gas engine sourcing"
      heading="Send the model code and serial number"
      text="Legacy series and gas engines are quoted line by line. Include the complete model code, serial number, and your parts list — photos of the nameplate help for older builds."
    />
  </div>
</BaseLayout>
